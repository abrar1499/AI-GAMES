rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function inChat(chatId) { return signedIn() && chatId.split('_').hasAny([request.auth.uid]); }

    // Profiles: anyone signed in can look people up by username; you can only edit your own,
    // and the username on it must be the one you logged in with.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid &&
        (!('username' in request.resource.data) || request.resource.data.username + '@lumo.app' == request.auth.token.email);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if inChat(chatId) && request.auth.uid in request.resource.data.members;
      // "Delete chat for everyone" (either person).
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if inChat(chatId);
        allow create: if inChat(chatId) && request.resource.data.sender == request.auth.uid;
        // The sender can edit or unsend; the other person may only hide it for themselves.
        allow update: if inChat(chatId) && (
          (resource.data.sender == request.auth.uid && request.resource.data.sender == request.auth.uid) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
        );
        allow delete: if inChat(chatId);
      }

      // Attachment pieces: only the two people in the chat can upload or download them.
      match /files/{part} {
        allow read, create, delete: if inChat(chatId);
      }
    }

    match /calls/{callId} {
      function call() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
      allow create: if signedIn() && request.resource.data.caller == request.auth.uid;
      allow read, update: if signedIn() &&
        (resource.data.caller == request.auth.uid || resource.data.callee == request.auth.uid);

      match /{side}/{candidate} {
        allow read, write: if signedIn() && request.auth.uid in [call().caller, call().callee];
      }
    }
  }
}
